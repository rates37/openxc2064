// HDL Grammar definition for custom HDL for openxc2064
// Can use https://www.lark-parser.org/ide/ to visualize and test grammar interactively

start: module+

// Module definition
module: "module" IDENT "(" port_list ")" ";" module_contents "endmodule"

// Ports for the modules
port_list: port ("," port)* // must have at least one port
port: direction IDENT
    | direction RANGE IDENT

direction: "input" | "output" | "inout"



// Module body:
module_contents: (wire_decl | reg_decl | assign_stmt | instance)*


// wire / reg declarations:
wire_decl: "wire" IDENT ";"
    | "wire" RANGE IDENT ";"

reg_decl: "reg" IDENT ";"
    | "reg" RANGE IDENT ";"



// assign statements:
assign_stmt: "assign" assign_stmt_lhs "=" expression ";"

assign_stmt_lhs: IDENT
    | IDENT INDEX
    | IDENT RANGE

expression: atom
    | expression OP expression // todo: operator precedence
    | "(" expression ")"

atom: IDENT
    | IDENT INDEX
    | IDENT RANGE
    | NUMBER



// instances:
instance: module_name ["#" "(" param_list ")"] module_instance_name "(" connection_list ")" ";"

module_name: IDENT
module_instance_name: IDENT

param_list: param ("," param)*
param: "." IDENT "(" expression ")" // force named parameters

connection_list: connection ("," connection)*
connection: "." IDENT "(" expression ")" // force named connections



// Utility rules
RANGE: "[" NUMBER ":" NUMBER "]" // e.g., [7:0]
INDEX: "[" NUMBER "]" // e.g., [3]
IDENT: /[a-zA-Z_][a-zA-Z0-9_]*/ // Identifiers (alphanumeric string starting with letter or underscore)
NUMBER: /[0-9]+('[bh][0-9A-Fa-f]+)?/
COMMENT: /\/\/[^\n]*/ // Single line comment
MULTILINE_COMMENT: "/*" /(.|\n)*?/ "*/"
// Operators: [+ - * / == != && || < >]
OP: /\+|-|\*|\/|==|!=|&&|\|\||</|>/
%ignore /[ \t\r\n]+/ // Ignore whitespace
%ignore COMMENT
%ignore MULTILINE_COMMENT
